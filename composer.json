{
    "name": "johnrivera7/filament-widget-drag-fit",
    "description": "Premium Filament dashboard collage: drag, resize, and fit widgets with per-user layouts, templates, and permissions.",
    "keywords": [
        "johnrivera7",
        "laravel",
        "filamentphp",
        "filament",
        "filament-plugin",
        "filament-widget-drag-fit",
        "widget-drag-fit",
        "draggable",
        "dashboard",
        "widgets",
        "drag-and-drop"
    ],
    "homepage": "https://github.com/Johnrivera7/filament-widget-drag-fit",
    "support": {
        "issues": "https://github.com/Johnrivera7/filament-widget-drag-fit/issues",
        "source": "https://github.com/Johnrivera7/filament-widget-drag-fit"
    },
    "license": "proprietary",
    "authors": [
        {
            "name": "John Rivera",
            "email": "johnriveragonzalez7@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "filament/forms": "^5.0",
        "filament/tables": "^5.0",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.7|^4.0",
        "pestphp/pest-plugin-arch": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "pestphp/pest-plugin-livewire": "^3.0|^4.0",
        "rector/rector": "^2.0",
        "spatie/laravel-ray": "^1.26"
    },
    "autoload": {
        "psr-4": {
            "JohnRivera7\\FilamentWidgetGrid\\": "src/",
            "JohnRivera7\\FilamentWidgetGrid\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JohnRivera7\\FilamentWidgetGrid\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": "phpstan analyse",
        "lint": "pint",
        "refactor": "rector",
        "test": "pest",
        "test:lint": "pint --test",
        "test:refactor": "rector --dry-run"
    },
    "extra": {
        "laravel": {
            "providers": [
                "JohnRivera7\\FilamentWidgetGrid\\FilamentWidgetGridServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
